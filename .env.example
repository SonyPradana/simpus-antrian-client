# Environment BFF. Salin ke `.env`, lalu isi yang perlu.
#
# `.env` tidak di-commit (berisi secret). File ini yang di-commit.
# Variabel yang sudah diset di shell menang atas isi file, jadi
# `MOCK_API=1 bun run dev` tetap bekerja.

# 1 = fixture lokal (src/server/mock.ts), 0 = HTTP ke Go API.
# Default kalau tidak diset: 0.
MOCK_API=0

# port BFF (UI + API)
PORT=3000

# lokasi file SQLite
ANTRIAN_DB=./data/antrian.db

# base URL Go API. Kalau diisi, menang atas nilai di Pengaturan.
APM_BASE_URL=http://localhost:8080

# key untuk facade /api/v1/apm/*. Wajib kalau MOCK_API=0.
APM_API_KEY=

# kalau diisi, login diaktifkan dan semua /api/* butuh sesi
AUTH_PASSWORD=

# APM_API_KEY dan AUTH_PASSWORD hanya dibaca BFF. Tidak pernah dikirim ke
# browser dan tidak disimpan di SQLite.
