{
  "name": "antrian-client",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "SonyPradana",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:*",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "bunx vite build && bun build --compile src/server/index.ts --outfile antrian-client.exe",
    "build:web": "bunx vite build",
    "build:server": "bun build --compile src/server/index.ts --outfile antrian-client.exe",
    "start": "bun src/server/index.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "shadcn": "bunx shadcn@latest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elysiajs/static": "^1.4.10",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "elysia": "^1.4.30",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.12",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
